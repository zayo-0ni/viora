# Android generated project: keep the sources we edit (manifest, gradle files),
# drop everything Gradle and cargo regenerate.
/src-tauri/gen/android/app/build/
/src-tauri/gen/android/build/
/src-tauri/gen/android/.gradle/
/src-tauri/gen/android/local.properties
/src-tauri/gen/android/app/src/main/jniLibs/
/src-tauri/gen/apple/build/

# Android release signing. CI writes these from secrets; they must never be
# committed — the key is the only thing that lets an update install over an
# existing build.
keystore.properties
*.jks
*.keystore

# Build outputs that land in the repo root. The APK is ~250 MB; one `git add .`
# would put it in history permanently.
*.apk
*.apk.idsig
*.idsig
